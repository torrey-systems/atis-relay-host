#!/bin/sh
set -e

disable_legacy_system_units() {
  if ! command -v systemctl >/dev/null 2>&1; then
    return 0
  fi

  systemctl disable --now pi-atc.service >/dev/null 2>&1 || true
  systemctl disable --now pi-atc-setup.service >/dev/null 2>&1 || true
  systemctl disable --now pi-atc-heartbeat.timer >/dev/null 2>&1 || true
  systemctl disable --now pi-atc-reboot.timer >/dev/null 2>&1 || true
}

case "$1" in
  remove|upgrade|deconfigure)
    disable_legacy_system_units
    ;;
esac

exit 0
